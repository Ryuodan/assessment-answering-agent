# ---------------------------------------------------------------------------
# Secrets — never commit
# ---------------------------------------------------------------------------
# GROQ_API_KEY lives here. .env.example is the tracked template and must stay
# visible, so it is re-included after the wildcard.
.env
.env.*
!.env.example

# ---------------------------------------------------------------------------
# Confidential content
# ---------------------------------------------------------------------------
# Uploaded guidelines and assessments — customer questionnaires, internal
# policies, completed compliance forms. None of it belongs in version control.
data/

# The Chroma index is not just vectors: it stores the raw text of every chunk
# ingested, so committing it leaks the same documents as data/ would.
chroma_db/
*.sqlite3

# Answers exported from the UI or `--out`, which quote the source material back.
*.answers.json
*.answers.csv
filled*.json

# ---------------------------------------------------------------------------
# Python
# ---------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class

# Build artefacts. *.egg-info/ is generated by `pip install -e .`.
build/
dist/
*.egg-info/
*.egg
.eggs/

# Virtual environments. The project uses a conda env (assessment_env) that lives
# outside the tree, but these show up when someone reaches for venv instead.
.venv/
venv/
env/
.python-version

# ---------------------------------------------------------------------------
# Tooling caches and test output
# ---------------------------------------------------------------------------
.pytest_cache/
.ruff_cache/
.mypy_cache/
.tox/
.coverage
.coverage.*
htmlcov/
.ipynb_checkpoints/

# ---------------------------------------------------------------------------
# Logs
# ---------------------------------------------------------------------------
logs/
*.log

# ---------------------------------------------------------------------------
# Editors and OS
# ---------------------------------------------------------------------------
.DS_Store
.idea/
.vscode/
*.swp

# Claude Code: settings.json is shared project config and stays tracked;
# settings.local.json holds per-developer overrides.
.claude/settings.local.json
