# ---------------------------------------------------------------------------
# LLM (Groq)
# ---------------------------------------------------------------------------
# Required. Get one at https://console.groq.com/keys
GROQ_API_KEY=

# Chat model used for extraction, drafting and review.
GROQ_CHAT_MODEL=openai/gpt-oss-120b
# How a reasoning model's thinking comes back. Groq's own default is "raw",
# which puts it INSIDE the message as <think>...</think> -- so with a reasoning
# model (qwen3, minimax-m2, deepseek-r1) the thinking lands where the answer
# belongs, and a reworded answer reads "<think>The user wants me to rewrite...".
# "parsed" keeps it beside the message, "hidden" drops it. Empty sends nothing,
# for a gateway that rejects the parameter.
GROQ_REASONING_FORMAT=parsed
# Regional endpoint. The groq client appends /openai/v1 itself, so this is the
# host root, not the full API path. Clear it to fall back to api.groq.com.
GROQ_BASE_URL=https://api.me-central-1.groqcloud.com

LLM_TEMPERATURE=0.0

# Model that grades eval/. Deliberately not GROQ_CHAT_MODEL: a system should
# not mark its own homework.
EVAL_JUDGE_MODEL=openai/gpt-oss-120b

# Key for the sealed eval data in eval/sealed/ (customer questionnaires and the
# team's answers). Ask whoever holds it; `uv run poe eval-unlock` needs it.
# Never commit a value here.
EVAL_DATA_KEY=

# ---------------------------------------------------------------------------
# Tracing (LangSmith)
# ---------------------------------------------------------------------------
# Records every LLM call, retrieval and graph step as a trace.
#
# OFF by default, and this one is a data decision rather than a debugging one:
# a trace carries the prompt, and the prompt carries the policy text retrieved
# to answer the question. LangSmith has no Saudi region -- the choices are EU
# and US -- so switching this on is a CROSS-BORDER TRANSFER of internal policy
# text and of the client questionnaires being answered. Enable it only when you
# are comfortable with that, and turn it off when you no longer need it.
LANGSMITH_TRACING=false
# EU region. Use https://api.smith.langchain.com for US. Neither is in Saudi.
LANGSMITH_ENDPOINT=https://eu.api.smith.langchain.com
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=Cyber-Assessment-Answering-Agent

# ---------------------------------------------------------------------------
# Tracing (Phoenix, on this machine)
# ---------------------------------------------------------------------------
# The same traces without the border crossing: Phoenix is an OpenTelemetry
# collector with a UI that understands LLM spans, and it runs where this runs.
#
# Needs the optional packages -- uv pip install -e ".[phoenix]" (there is no
# plain pip inside .venv) -- and a collector listening at PHOENIX_ENDPOINT.
# Install the collector once with `uv tool install --python 3.12 arize-phoenix`
# (it needs Python 3.12+; this app runs on 3.11), then start it with
# `phoenix serve`. The step-by-step is under "Tracing" in the README. If nothing
# is listening the spans are dropped with a warning and answering carries on.
#
# Off by default all the same. A trace holds the prompt, which holds the policy
# text and the customer's questionnaire, so Phoenix's store is a second copy of
# both with no sign-in in front of it. Local is not the same as harmless.
PHOENIX_TRACING=true
PHOENIX_ENDPOINT=http://localhost:6006/v1/traces
PHOENIX_PROJECT=assessment-answer

# ---------------------------------------------------------------------------
# Embeddings (BGE-M3, OpenAI-compatible endpoint)
# ---------------------------------------------------------------------------
# Multilingual (Arabic + English), 1024-d. No API key required today, but the
# OpenAI-compatible client insists on sending one, so a placeholder is used.
EMBEDDING_BASE_URL=https://ds.t2.sa/text_embed/v1
EMBEDDING_MODEL=bge-m3
EMBEDDING_API_KEY=unused
# Seconds one embedding request (up to 64 chunks) may take before it is retried,
# twice, and then fails. Bounds one batch, not a whole file (TD-034).
EMBEDDING_TIMEOUT=300

# ---------------------------------------------------------------------------
# Document conversion (Docling)
# ---------------------------------------------------------------------------
# Host root of the Docling container on the testing server. The endpoint paths
# (/v1/convert/file, /v1/convert/source) are appended by the client. Clear it to
# skip Docling and use the local pdfplumber / python-docx loaders.
DOCLING_BASE_URL=http://localhost:8092
# Seconds, per HTTP request (submit, poll, fetch a result) — not per conversion.
DOCLING_TIMEOUT=180
# Seconds, total budget for one document's conversion across all its polls. A
# 161-page standard runs well past the 300s cap docling-serve puts on
# synchronous requests, which is why conversion is submitted asynchronously.
DOCLING_CONVERSION_TIMEOUT=2400
# Force OCR on every document. Normally unnecessary and ~2.3x slower: Docling
# recognises table structure with a separate model that runs either way, so on
# a born-digital PDF the only text OCR adds is what it reads off the logos.
DOCLING_DO_OCR=false
# Turn OCR on automatically for a PDF with no usable text layer, so a scanned
# upload is still read without making OCR everyone's default.
DOCLING_OCR_AUTO=true
DOCLING_IMAGE_EXPORT_MODE=placeholder
# Docling emits Markdown with no page information. Given this placeholder it
# inserts one between pages, which the client rewrites into the numbered
# markers the chunker already reads -- so an answer can cite a page as well as
# a clause. Must be a string that cannot occur in a document.
DOCLING_PAGE_BREAK_PLACEHOLDER=<!-- docling-page-break -->
# Build a real heading hierarchy from bookmarks, numbering and styles. Docling
# leaves this off, which flattened 85 of 86 documents to a single heading level
# and left the chunker no tree to divide a long chapter by.
DOCLING_HEADING_HIERARCHY=true
# Fall back to local extraction when Docling is unreachable. Set false to make a
# broken Docling fail the upload instead of quietly degrading.
DOCLING_FALLBACK_LOCAL=true

# ---------------------------------------------------------------------------
# Storage
# ---------------------------------------------------------------------------
CHROMA_DIR=./chroma_db
COLLECTION_NAME=assessment_knowledge
UPLOAD_DIR=./data/uploads
# Filled copies of questionnaires, one directory per batch so two people
# answering the same file do not write over each other's output.
FILLED_DIR=./data/filled
EXTRACTED_TEXT_DIR=./data/extracted

# ---------------------------------------------------------------------------
# Retrieval + answering behaviour
# ---------------------------------------------------------------------------
# Guideline chunks retrieved per search query (a question may run several).
TOP_K_GUIDELINES=8
TOP_K_PRIOR_ANSWERS=5
# Split a multi-part question into one search per part before retrieving.
# Costs one extra LLM call per question. Set false to search the question's
# own wording alone.
QUERY_EXPANSION=true
MAX_SEARCH_QUERIES=6
# Search a question the way it was searched before (plan 034): the first plan that
# worked is kept per question, product and language. false plans every time.
REUSE_SEARCH_PLANS=true
# Fuse a BM25 pass with the dense search, for exact figures embeddings blur.
# Measured worse than dense alone on the T2 policy corpus (71.4% vs 73.6%) --
# it promotes the wrong section of the right document as often as it rescues a
# buried figure. Turn on and re-run eval/ if your questions are mostly
# exact-figure lookups.
HYBRID_SEARCH=false
LEXICAL_WEIGHT=0.4
# Cross-encoder reranking of retrieved evidence, once per question. Downloads
# ~2.3 GB on first use and wants a GPU: on CPU it adds roughly 30s per question.
RERANKER_ENABLED=false  # +13.4 points more but has 30s overhead for each question using cpu only
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
# How many draft -> review rounds a single question may go through.
MAX_ANSWER_ATTEMPTS=3
# Questions answered in parallel. Raise carefully: Groq rate limits apply.
MAX_CONCURRENT_QUESTIONS=4
# Rewordings (preferences, skills, "make them shorter", brief answers) sent to
# the model at once. Each is one call per answer; past this they wait their turn.
MAX_CONCURRENT_REWRITES=8

# ---------------------------------------------------------------------------
# Storage limits
# ---------------------------------------------------------------------------
# Each person's stored files: the questionnaires they uploaded and the filled
# copies written from them. Under the limit nothing is removed. Over it, the
# files of the work they have not used longest are removed first, until they are
# back under again. Never removed, whatever the limit: a document the team's
# knowledge base was built from, or anything used in the last STORAGE_KEEP_DAYS
# days -- so a limit set too low for somebody's workload leaves them over it
# (and says so in the log) rather than deleting work in progress. Per person: a
# new colleague brings their own allowance. 0 turns the limit off.
STORAGE_LIMIT_PER_USER_MB=2048
STORAGE_KEEP_DAYS=30
# Saved work nobody has opened or changed for this many days -- questionnaires,
# typed lists and chats, with their answers and files, and the answered runs
# older than this -- is deleted, at start-up and then about once a day. Never
# the knowledge base, the answer memory, products, people or the event log.
# Opening a questionnaire or a chat counts as using it. 0 keeps everything.
RETENTION_DAYS=180
# At or below this score an answer is held for human review, and a held answer never shows a higher score.
REVIEW_CONFIDENCE_THRESHOLD=0.6

CHUNK_SIZE=1200
CHUNK_OVERLAP=150
# Characters of source document fed to the LLM per extraction window.
EXTRACTION_WINDOW=2000

LOG_LEVEL=INFO
# How log lines are written: text (for a person) or json (one object per line,
# for a log collector). Secrets are redacted either way.
LOG_FORMAT=text

# ---------------------------------------------------------------------------
# Tuning that rarely needs changing, listed so nothing is invisible
# ---------------------------------------------------------------------------
# Sources shown to the drafter per question, after ranking.
MAX_EVIDENCE_CHUNKS=38
# How many of those may be previous answers. Previous answers are shown first,
# so without a ceiling they fill the prompt and the policies that answer the
# question never reach the drafter. Raise it where the previous answers are the
# authority; lower it to make the drafter lean on the guidelines.
MAX_PRIOR_ANSWER_CHUNKS=4

# Keep a retrieved unit only if it scores within this fraction of the best hit
# for the question, so a simple lookup is answered from a handful of chunks and
# a synthesis question still gets the full budget. 0 disables it. Judged on the
# agreement-weighted score, so a clause several searches converged on survives a
# floor its raw cosine would not.
# Set it high or leave it off: BGE-M3 cosines on policy prose bunch tightly, and
# on this corpus the median retrieved chunk still scores 94% of the best hit, so
# anything below about 0.90 discards nothing at all.
EVIDENCE_SCORE_FLOOR=0.0
# Never prune below this many chunks, whatever the floor says.
MIN_EVIDENCE_CHUNKS=8

# Grade each retrieved chunk against the question with an LLM and re-order the
# evidence by the verdicts. Cosine cannot do this job on policy prose: even the
# five best-ranked chunks are only about a third on-target, and every threshold
# tried on the score itself cost two to four points of recall per point of
# precision. Costs one extra round of short, batched calls per question.
RELEVANCE_FILTER_ENABLED=false
# Chunks per grading call. One call per chunk trips Groq's rate limit on a full
# assessment; a dozen per call makes it about three calls per question.
RELEVANCE_FILTER_BATCH=12
# Chunks always kept regardless of the verdicts, so a false negative on the one
# chunk carrying the answer cannot strip it.
RELEVANCE_FILTER_KEEP=8
# Blank uses GROQ_CHAT_MODEL. A smaller model is faster, but verify it on Arabic
# before trusting it -- half this corpus is Arabic and small models degrade
# there first.
RELEVANCE_FILTER_MODEL=
# Characters of each chunk shown to the grader.
RELEVANCE_FILTER_SNIPPET=700
# Move graded-relevant material to the front, not just delete off-target
# material from the back. The drafter cites about eight sources however many it
# is shown, so a filter that only trims the tail cannot reach the answer.
RELEVANCE_FILTER_PROMOTE=true
# Cap on pulling in the sibling parts of one split unit.
MAX_EXPANDED_CHARS=12000
# Ceiling on confidence when a mechanical check fires.
INCOMPLETE_LIST_CONFIDENCE_CAP=0.5
# Tokens the cross-encoder reads per (question, chunk) pair.
RERANKER_MAX_LENGTH=1024
# Pairs scored at once. Larger is faster and uses more memory.
RERANKER_BATCH_SIZE=16

# How much a chunk gains for each extra search that independently returned it.
# Query expansion runs several overlapping searches per question, so agreement
# between them is a free relevance signal. 0 disables it; with QUERY_EXPANSION
# off it has no effect either way.
QUERY_AGREEMENT_WEIGHT=0.15
# A split unit is completed at retrieval so the drafter never sees three items
# of a nine-item series and calls it the list. Above this many parts the unit is
# a chapter rather than a series, and expanding it filled every prompt slot from
# one document. Every part repeats the unit's stem, so an unexpanded hit still
# carries its context.
MAX_EXPANDED_PARTS=6

# --- Identity and history -----------------------------------------------
# Access is managed at /admin once the system is running, because whoever runs
# the host may not be whoever decides who uses it. These two settings exist so
# there is a first way in.
#
# The break-glass administrator, re-applied at EVERY startup. This is the way
# back in if a password is lost or the last admin is removed by accident, which
# is also why its password cannot be changed on the admin page -- create a
# second administrator there for everyday use. Signing in with this account
# uses ADMIN_PASSWORD rather than a team access code.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Members to create on a FIRST run only, comma-separated. After that the admin
# page is authoritative: someone removed there stays removed, and this list
# does not restore them on the next restart. Leave empty for a new deployment
# and add people on the page instead.
ALLOWED_EMAILS=
# Products added to the default team on the first start, comma-separated. Each
# gets a knowledge base and an answer memory of its own beside the shared ones.
# Applied once: after that the Products page is authoritative. For example:
#   SEED_PRODUCTS=Availo,Msegat,Ole5,RICH,SouqT2
SEED_PRODUCTS=
# Everyone who signs in joins this team. Teams share one knowledge base, one set
# of answers and one history, which is why a colleague's submission to the same
# bank is findable.
DEFAULT_TEAM=cybersecurity
# How long a sign-in lasts, in days.
SESSION_TTL_DAYS=30
# Users, teams, sessions, the event log and answered runs. One SQLite file, so
# there is no second service to run and one thing to copy for a backup.
DB_PATH=./data/app.db
# Who this deployment answers on behalf of: name, sector, certifications (JSON).
# Missing means the built-in profile.
ORGANISATION_PATH=./data/organisation.json
# Where serve.sh writes the server's output; `python -m src.cli inspect request <id>`
# prints the lines of one request from it.
SERVER_LOG_PATH=./logs/server.log

# Sign-in throttling. A team's access code is shared and typeable, so it is only
# as strong as the number of guesses allowed against it. Counted per address,
# because an attacker with a pool of IPs would otherwise spread guesses across
# them; a correct sign-in clears the count, so an earlier typo cannot lock
# someone out later.
SIGN_IN_MAX_ATTEMPTS=10
SIGN_IN_LOCKOUT_MINUTES=15

# How hard to work at understanding an uploaded questionnaire.
#
#   rules     the hand-written rules alone. No network, milliseconds, free, and
#             correct on every questionnaire we have seen.
#   assisted  the rules, then one model call for each sheet they could not read.
#             Can rescue a sheet in an unfamiliar shape; cannot damage one the
#             rules read correctly, because it is kept only when it finds more.
#   agent     an agent explores the whole workbook with read-only tools and
#             reads every sheet itself. The most flexible and by far the most
#             expensive: measured at 666k tokens and three minutes across
#             nineteen files, against the rules' nothing.
#   hybrid    the rules, then the agent -- but shown only the sheets the rules
#             lost. The exploring without the re-reading.
#   guarded   the agent, floored by the rules: no sheet may come back with
#             fewer questions than the rules found in it. The agent generalises
#             best but its characteristic mistake is a quiet omission -- on one
#             workbook it read six sheets of seven and dropped the last without
#             saying so. This is the agent with that failure removed, and it is
#             the default.
#
# Measured against each other by `python -m scripts.compare_detection`.
DETECTION_STRATEGY=guarded

# Used by the 'assisted' strategy, and by 'rules' if you turn it on directly.
# A sheet where fewer than this share of the rows below the header became
# questions is treated as read wrongly rather than as a short questionnaire,
# and offered to the model as well.
DETECTION_ASSIST=false
DETECTION_ASSIST_COVERAGE=0.25
DETECTION_ASSIST_MIN_ROWS=20

# A floor on the Excel agent's step budget; the real budget scales with the
# number of visible sheets, because a fixed one ran out halfway through an
# eighteen-sheet workbook.
EXCEL_AGENT_MAX_STEPS=24
