# ---------------------------------------------------------------------------
# LLM (Groq)
# ---------------------------------------------------------------------------
# Required. Get one at https://console.groq.com/keys
GROQ_API_KEY=

# Chat model used for extraction, drafting and review.
GROQ_CHAT_MODEL=minimaxai/minimax-m2.7
# Regional endpoint. The groq client appends /openai/v1 itself, so this is the
# host root, not the full API path. Clear it to fall back to api.groq.com.
GROQ_BASE_URL=https://api.me-central-1.groqcloud.com

LLM_TEMPERATURE=0.0

# ---------------------------------------------------------------------------
# Embeddings (BGE-M3, OpenAI-compatible endpoint)
# ---------------------------------------------------------------------------
# Multilingual (Arabic + English), 1024-d. No API key required today, but the
# OpenAI-compatible client insists on sending one, so a placeholder is used.
EMBEDDING_BASE_URL=https://ds.t2.sa/text_embed/v1
EMBEDDING_MODEL=bge-m3
EMBEDDING_API_KEY=unused

# ---------------------------------------------------------------------------
# Document conversion (Docling)
# ---------------------------------------------------------------------------
# Host root of the Docling container on the testing server. The endpoint paths
# (/v1/convert/file, /v1/convert/source) are appended by the client. Clear it to
# skip Docling and use the local pdfplumber / python-docx loaders.
DOCLING_BASE_URL=http://localhost:8092
# Seconds. A long scanned PDF takes minutes, not seconds.
DOCLING_TIMEOUT=180
# Turn on only for scanned documents — it is much slower.
DOCLING_DO_OCR=false
DOCLING_IMAGE_EXPORT_MODE=placeholder
# Fall back to local extraction when Docling is unreachable. Set false to make a
# broken Docling fail the upload instead of quietly degrading.
DOCLING_FALLBACK_LOCAL=true

# ---------------------------------------------------------------------------
# Storage
# ---------------------------------------------------------------------------
CHROMA_DIR=./chroma_db
COLLECTION_NAME=assessment_knowledge
UPLOAD_DIR=./data/uploads
EXTRACTED_TEXT_DIR=./data/extracted

# ---------------------------------------------------------------------------
# Retrieval + answering behaviour
# ---------------------------------------------------------------------------
TOP_K_GUIDELINES=5
TOP_K_PRIOR_ANSWERS=5
# How many draft -> review rounds a single question may go through.
MAX_ANSWER_ATTEMPTS=2
# Questions answered in parallel. Raise carefully: Groq rate limits apply.
MAX_CONCURRENT_QUESTIONS=4
# Below this score an answer is flagged for human review in the UI.
REVIEW_CONFIDENCE_THRESHOLD=0.6

CHUNK_SIZE=1200
CHUNK_OVERLAP=150
# Characters of source document fed to the LLM per extraction window.
EXTRACTION_WINDOW=8000

LOG_LEVEL=INFO
